{
  "schema": "thoth.pink_rebrand/1",
  "upstream": "upstream.json",
  "package_json": {
    "set": {
      "name": "@thoth/pink",
      "version": "0.84.3-pink.5",
      "description": "Pink: coding agent of the Thoth project, a fork of Pi with the Pi name replaced by Pink and a pink theme",
      "piConfig": {
        "name": "pink",
        "configDir": ".pink"
      },
      "bin": {
        "pink": "dist/bundle/cli.js"
      },
      "thoth": {
        "fork_of": "@earendil-works/pi-coding-agent@0.84.3",
        "license_of_upstream": "MIT (see LICENSE-PI.txt)",
        "rebrand": "rebrand.json in the Thoth repository (pink/)"
      }
    },
    "files_add": [
      "LICENSE-PI.txt",
      "NOTICE.md",
      "extensions"
    ]
  },
  "add_files": [
    {
      "from": "theme/pink.json",
      "to": "dist/modes/interactive/theme/pink.json"
    },
    {
      "from": "LICENSE-PI.txt",
      "to": "LICENSE-PI.txt"
    },
    {
      "from": "NOTICE.md",
      "to": "NOTICE.md"
    },
    {
      "from": "README.md",
      "to": "README.md",
      "overwrite": true
    },
    {
      "from": "docs/PINK.md",
      "to": "docs/PINK.md"
    },
    {
      "from": "extensions/pink-ui.ts",
      "to": "extensions/pink-ui.ts"
    }
  ],
  "shrinkwrap": {
    "file": "npm-shrinkwrap.json"
  },
  "env_rename": {
    "files": [
      "dist/bundle/**/*.js"
    ],
    "exclude": [
      "dist/bundle/chunks/lib-HGQMNYVT.js",
      "dist/bundle/chunks/chunk-XDUWOHPL.js"
    ],
    "regex": "(?<![A-Za-z0-9_])PI_(?=[A-Z])",
    "replace": "PINK_",
    "min_count": 40
  },
  "replacements": [
    {

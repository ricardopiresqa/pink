      "file": "dist/bundle/chunks/chunk-E5KXRMZK.js",
      "find": "[source|self|pi]",
      "replace": "[source|self|pink]",
      "count": 2
    },
    {
      "id": "update-text",
      "file": "dist/bundle/chunks/chunk-E5KXRMZK.js",
      "regex": true,
      "find": "Update pi(?![\\w-])",
      "replace": "Update pink",
      "count": 7
    },
    {
      "id": "update-reinstall",
      "file": "dist/bundle/chunks/chunk-E5KXRMZK.js",
